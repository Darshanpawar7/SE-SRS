# Supabase Configuration
# Optional: The app works out of the box with offline/mock fallback!
# When you have a Supabase project, fill these in or configure via in-app Settings:
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use the publishable/anon public key only. Never put a service-role or secret key here.
VITE_SUPABASE_ANON_KEY=your-anon-public-key
